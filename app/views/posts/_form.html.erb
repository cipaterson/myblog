<%= form_with model: post do |form| %>
  <% if post.errors.any? %>
    <div class="errors">
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, autofocus: true, required: true %>
  </div>

  <div class="field">
    <%= form.label :body, "Body" %>
    <%# Drag or paste an image straight into the editor: Trix uploads it via
        Active Storage and it renders through the 800px variant. %>
    <%= form.rich_text_area :body %>
  </div>

  <div data-controller="publication-date">
    <div class="field field--inline">
      <%= form.check_box :published, data: { publication_date_target: "toggle" } %>
      <%= form.label :published, "Published" %>
    </div>

    <%# A date is only meaningful for a published post, so it stays hidden until
        the checkbox is ticked. Rendered hidden for drafts so it does not flash
        before Stimulus connects. %>
    <div class="field" data-publication-date-target="field" <%= "hidden" unless post.published? %>>
      <%= form.label :published_at, "Publication date" %>
      <p class="field__hint">Leave blank to date the post from the moment you publish it. Times are UTC.</p>
      <%= form.datetime_local_field :published_at, include_seconds: false %>
    </div>
  </div>

  <div class="actions">
    <%= form.submit post.persisted? ? "Save" : "Create post" %>
    <%= link_to "Cancel", post.persisted? ? post_path(post) : posts_path %>
  </div>
<% end %>
