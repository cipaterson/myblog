<%# After PreprocessEmbedsJob runs the blob's stored file is already the resized
    800px version, served directly. Falls back to a variant for the brief window
    before the job completes. %>
<figure class="attachment attachment--<%= blob.representable? ? "preview" : "file" %> attachment--<%= blob.filename.extension %>">
  <% if blob.representable? %>
    <% src = blob.metadata["resized"] ? blob.url : blob.representation(**InlineImage::VARIANT) %>
    <%= image_tag src, loading: "lazy", alt: blob.try(:caption).presence || blob.filename.base %>
  <% end %>

  <% if caption = blob.try(:caption).presence %>
    <figcaption class="attachment__caption"><%= caption %></figcaption>
  <% end %>
</figure>
