<%# Direct uploads land public-read (see s3_direct_upload_acl.rb), so blob.url
    works immediately. PreprocessEmbedsJob later replaces the file in-place with
    the 800px resized version at the same URL. No variants are ever created. %>
<figure class="attachment attachment--<%= blob.representable? ? "preview" : "file" %> attachment--<%= blob.filename.extension %>">
  <% if blob.representable? %>
    <%= image_tag blob.url, loading: "lazy", alt: blob.try(:caption).presence || blob.filename.base %>
  <% end %>

  <% if caption = blob.try(:caption).presence %>
    <figcaption class="attachment__caption"><%= caption %></figcaption>
  <% end %>
</figure>
