<article class="comment" id="comment-<%= comment.id %>">
  <div class="comment__head">
    <span class="comment__author"><%= comment.author_name %></span>
    <time class="meta" datetime="<%= comment.created_at.iso8601 %>"><%= comment.created_at.strftime("%d %b %Y") %></time>
    <% if authenticated? %>
      <%= button_to "Delete", comment_path(comment), method: :delete,
                    form: { data: { turbo_confirm: "Delete this comment?" } },
                    class: "button--plain" %>
    <% end %>
  </div>

  <p class="comment__body"><%= comment.body %></p>
</article>
